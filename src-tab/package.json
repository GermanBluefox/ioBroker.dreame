{
  "name": "iobroker.dreame-tab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "React views of ioBroker.dreame: the admin tab, built into ../admin/tab.html, and the stand-alone page, built into ../www.",
  "scripts": {
    "start": "vite",
    "build": "vite build && vite build --config vite.web.config.ts",
